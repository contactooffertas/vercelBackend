# Mercado Pago automático para múltiples vendedores
# Crear una sola aplicación de Rosario Market en Mercado Pago Developers.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://new-backend-lovat.vercel.app/api/business/mercadopago/callback

# Clave larga y aleatoria para cifrar los tokens OAuth guardados.
# Si queda vacía, el servidor usa JWT_SECRET como respaldo.
MP_TOKEN_ENCRYPTION_KEY=

# JSON completo de la cuenta de servicio, configurado solo como secreto del servidor.
FIREBASE_SERVICE_ACCOUNT_JSON=

FRONTEND_URL=https://www.rosariomarket.com.ar
